<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The sign-in session is encrypted with a key that never leaves this phone; never copy it. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="trimax_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trimax_auth.xml" />
    </device-transfer>
</data-extraction-rules>
