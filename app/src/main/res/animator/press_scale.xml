<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable cards dip slightly while pressed and spring back on release -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <set>
            <objectAnimator android:duration="110" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:duration="110" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="240" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:duration="240" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
</selector>
