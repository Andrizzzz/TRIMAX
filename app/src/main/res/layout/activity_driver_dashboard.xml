<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DriverDashboardActivity">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main">

        <!-- SCROLLABLE BODY -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- TOP BLUE HEADER SECTION -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_header_card"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">

                    <!-- Menu & Actions Top Bar -->
                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Menu"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@android:color/white" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Online Status Badge Pill Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleDuty"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#10B981"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Online"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />

                        <ImageView
                            android:id="@+id/btnThemeToggle"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Theme"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/ic_sun"
                            app:tint="@android:color/white" />

                        <ImageView
                            android:id="@+id/btnDriverNotifications"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Notifications"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/baseline_notifications_none_24"
                            app:tint="@android:color/white" />
                    </LinearLayout>

                    <!-- Driver Greeting -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/btnMenu"
                        android:layout_marginTop="16dp"
                        android:text="Good Morning,"
                        android:textColor="#D1E2FF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDriverGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/btnMenu"
                        android:layout_marginTop="34dp"
                        android:text="Juan Santos 👋"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- STATS ROW (3 COLUMNS) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvDriverGreeting"
                        android:layout_marginTop="20dp"
                        android:background="#1AFFFFFF"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deliveries"
                                android:textColor="#D1E2FF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#33FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱1,200"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Earnings"
                                android:textColor="#D1E2FF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#33FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="98%"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="On Time"
                                android:textColor="#D1E2FF"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </RelativeLayout>

                <!-- CURRENT DELIVERY CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Delivery"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAssignedDeliveryHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvHeroBookingId"
                                    android:layout_width="match_parent"
                                    android:layout_toStartOf="@id/tvHeroStatusPill"
                                    android:layout_marginEnd="8dp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:layout_height="wrap_content"
                                    android:text="TRK-2024001"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvHeroStatusPill"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:background="@drawable/bg_pill_unselected"
                                    android:backgroundTint="#DCFCE7"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:text="In Transit"
                                    android:textColor="#16A34A"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <!-- Sequence & Customer -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvHeroSequence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Seq #1"
                                    android:textColor="@color/primary_blue"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="6dp"
                                    android:text="•"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvHeroCustomerName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:text="Juan Dela Cruz"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Addresses -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroPickup"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:breakStrategy="simple"
                                    android:hyphenationFrequency="none"
                                    android:text="Pickup: San Jose del Monte"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvHeroDestination"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:breakStrategy="simple"
                                    android:hyphenationFrequency="none"
                                    android:layout_marginTop="4dp"
                                    android:text="Drop-off: Quezon City"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvHeroSpecialInstructions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:breakStrategy="simple"
                                    android:hyphenationFrequency="none"
                                    android:layout_marginTop="6dp"
                                    android:text="⚠️ Special Instructions"
                                    android:textColor="#D97706"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Action Buttons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHeroStartDelivery"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="Start Delivery"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary_blue"
                                    android:textSize="11sp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textStyle="bold"
                                    app:cornerRadius="12dp"
                                    app:strokeColor="@color/primary_blue" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHeroViewDetails"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="2dp"
                                    android:backgroundTint="@color/primary_blue"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="View Details"
                                    android:textAllCaps="false"
                                    android:textColor="@android:color/white"
                                    android:textSize="11sp"
                                    android:maxLines="2"
                                    android:ellipsize="end"
                                    android:textStyle="bold"
                                    app:cornerRadius="12dp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHeroReportProblem"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="4dp"
                                android:text="Report Problem"
                                android:textAllCaps="false"
                                android:textColor="#EF4444"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- DRIVER NAVIGATION & TASKS: restored dashboard action cards -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="Driver Navigation &amp; Tasks"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAssignedDeliveries"
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">
                            <TextView
                                android:id="@+id/tvDelivBadge"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_icon_badge"
                                android:backgroundTint="#2563EB"
                                android:gravity="center"
                                android:text="3"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_toStartOf="@id/tvDelivBadge"
                                android:layout_marginEnd="8dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="📦 All Assigned Bookings"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDriverMap"
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:gravity="start|bottom"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="🗺 Driver Live Map"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDeliveryHistory"
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:gravity="start|bottom"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="📜 Delivery History"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardEmergencySupport"
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/card_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:gravity="start|bottom"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="🚨 Support &amp; Emergency"
                                android:textColor="#EF4444"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Hidden compatibility views -->
                <TextView android:id="@+id/tvDutyStatusPill" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvGpsTrackingLabel" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvLat" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvLng" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/tvAccuracy" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <com.example.trimax.MockMapView android:id="@+id/driverDashboardMapView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTrackFullMap" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BOTTOM NAVIGATION -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            app:elevation="8dp"
            app:itemIconTint="@color/primary_blue"
            app:itemRippleColor="#3B82F6"
            app:itemTextColor="@color/primary_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDE NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_bg"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/primary_blue"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
