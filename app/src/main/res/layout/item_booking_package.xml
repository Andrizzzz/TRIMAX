<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivPackageImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Item Image"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delivery_van" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPackageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coke Case (24 Bottles)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPackageDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wholesale delivery of Coca-Cola cases."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Price; with a discount the old price is struck through and the new one shows beside it -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPackagePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱ 180.00"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPackageNetPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/status_confirmed"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Only on items the Admin allows: opens the "Less per piece" sheet -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLess"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Less"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:visibility="gone"
                app:chipBackgroundColor="@color/surface_alt"
                app:chipCornerRadius="14dp"
                app:chipIcon="@drawable/ic_tag_less"
                app:chipIconSize="14dp"
                app:chipIconTint="@color/primary_blue"
                app:chipMinHeight="28dp"
                app:chipStrokeWidth="0dp"
                app:closeIcon="@drawable/ic_chevron_down_small"
                app:closeIconSize="14dp"
                app:closeIconTint="@color/primary_blue"
                app:closeIconVisible="true"
                app:ensureMinTouchTargetSize="false" />
        </LinearLayout>

        <!-- Quantity Stepper (- [0] +) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />

            <TextView
                android:id="@+id/tvItemQuantity"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:cornerRadius="10dp"
                app:strokeColor="#CBD5E1" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
