<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:background="#2563EB"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/ivHeaderAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_badge"
        android:contentDescription="Agent Avatar"
        android:padding="12dp"
        android:src="@drawable/ic_user"
        app:tint="@color/primary_blue" />

    <TextView
        android:id="@+id/tvNavHeaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Agent Lance"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNavHeaderEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="lance@email.com"
        android:textColor="#E0E7FF"
        android:textSize="13sp" />

</LinearLayout>